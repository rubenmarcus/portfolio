{
  "name": "rubenmarcus-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/vercel-route-policy.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "text:gate": "node scripts/text-gate.mjs",
    "aeo:gate": "node scripts/discovery-gate.mjs",
    "x:init": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs init",
    "x:doctor": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs doctor",
    "x:validate": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs validate-accounts",
    "x:sync": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs sync-rules",
    "x:watch": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs watch",
    "x:queue": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs queue",
    "x:show": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs show",
    "x:prepare": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs prepare",
    "x:install-service": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs install-service",
    "x:replay": "node --disable-warning=ExperimentalWarning scripts/x-watch/cli.mjs replay --file scripts/x-watch/fixtures/sample-stream.jsonl --mock-drafts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3",
    "@astrojs/svelte": "^7",
    "@astrojs/tailwind": "^6",
    "@astrojs/vercel": "^9.0.5",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "aeo.js": "^0.0.16",
    "astro": "^5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "svelte": "^5",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/three": "^0.182.0",
    "autoprefixer": "^10.4.20",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "license": "MIT"
}
