---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DitherBg from "../../components/DitherBg.svelte";
import Section from "../../components/Section.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import HireAgent from "../../components/HireAgent.svelte";
import ConnectStats from "../../components/ConnectStats.svelte";
import SvgIcon from "../../lib/assets/SvgIcon.svelte";
import { CONNECT_PT, MCP_URL } from "../../lib/data/connect";

// O conteúdo mora em src/lib/data/connect.ts pra /pt/connect e /pt/connect.md
// não divergirem — o agent que lê o Markdown vê exatamente os mesmos passos.
const { clients, tools } = CONNECT_PT;
---

<BaseLayout
  lang="pt-br"
  title={CONNECT_PT.title}
  description={CONNECT_PT.description}
  image="/og/pt-connect.png"
  markdownPath="/pt/connect.md"
>
  <DitherBg client:load opacity={0.55} />

  <Section id="intro" pageHeader>
    <SectionHeader
      level={1}
      index="08"
      overline={CONNECT_PT.overline}
      title={CONNECT_PT.headline}
      description={CONNECT_PT.intro}
    />

    <div class="url-bar" data-reveal>
      <span class="url-bar__label">{CONNECT_PT.endpointLabel}</span>
      <code class="url-bar__url" id="mcp-url">{MCP_URL}</code>
      <button class="url-bar__copy" data-copy={MCP_URL}>copiar</button>
    </div>

    <div class="client-grid">
      {clients.map((c, i) => (
        <div class="client-card" data-reveal>
          <div class="client-card__top">
            <span class="client-card__icon"><SvgIcon name={c.icon} size={24} /></span>
            <span class="client-card__num">{String(i + 1).padStart(2, "0")}</span>
          </div>
          <h2 class="client-card__name">{c.name}</h2>
          <ol class="client-card__steps">
            {c.steps.map((s) => (
              <li>
                {s.text}
                {s.url && (
                  <span class="step-url">
                    <code class="step-url__code">{MCP_URL}</code>
                    <button class="step-url__copy" data-copy={MCP_URL} aria-label={`Copiar o endpoint MCP para ${c.name}`}>copiar</button>
                  </span>
                )}
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>

    <div class="tools-block" data-reveal>
      <span class="bracket" data-reveal-item>{CONNECT_PT.toolsHeading}</span>
      <ul class="tools-list">
        {tools.map((t) => (
          <li class="tools-list__row" data-reveal-item>
            <code class="tools-list__name">{t.name}</code>
            <span class="tools-list__desc">{t.desc}</span>
          </li>
        ))}
      </ul>
      <p class="tools-block__note" data-reveal-item>
        Prefere HTTP puro? <code>GET /api/resume.json</code> devolve o CV legível por máquina,
        <code>POST /api/hire</code> recebe um brief. Pessoas de terminal: <code>curl rubenmarcus.dev</code>.
      </p>
    </div>
  </Section>

  <Section id="telemetry" tight>
    <SectionHeader
      index="09"
      overline="Telemetria ao vivo"
      title="Agents já estão chamando este site."
      description="Contadores direto do banco de observabilidade: chamadas MCP, agents conectados e as superfícies de máquina que eles consomem."
    />
    <ConnectStats client:visible lang="pt" />
  </Section>

  <Section id="agents-md" tight>
    <HireAgent client:visible lang="pt" />
  </Section>
</BaseLayout>

<script>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.getAttribute("data-copy") ?? "";
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();
      }
      btn.textContent = "copiado ✓";
      setTimeout(() => (btn.textContent = "copiar"), 2000);
    });
  });
</script>

<style>
  .url-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    border: 1px solid rgba(0, 255, 65, 0.3);
    border-radius: var(--radius-card);
    background: #06080c;
    padding: 0.9rem 1.2rem;
    margin-bottom: 2.5rem;
  }
  .url-bar__label {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-soft);
  }
  .url-bar__url {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent);
    text-shadow: 0 0 12px rgba(0, 255, 65, 0.35);
  }
  .url-bar__copy {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.8rem;
    cursor: pointer;
  }
  .url-bar__copy:hover {
    color: var(--accent);
    border-color: rgba(0, 255, 65, 0.4);
  }

  .client-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 680px) {
    .client-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1120px) {
    .client-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .client-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    transition: border-color var(--duration-hover) var(--ease-default);
  }
  .client-card:hover { border-color: rgba(0, 255, 65, 0.35); }

  .client-card__num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted-soft);
  }
  .client-card__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    margin: 0;
  }
  .client-card__steps {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* O endpoint é um token longo e inquebrável. Recebe a própria linha dentro da
     etapa, pode quebrar em qualquer ponto, e o botão de copiar não é espremido. */
  .step-url {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.35rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid rgba(0, 255, 65, 0.18);
    border-radius: var(--radius-sm, 6px);
    background: rgba(0, 12, 5, 0.5);
  }
  .step-url__code {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    line-height: 1.35;
    color: var(--accent);
    overflow-wrap: anywhere;
    word-break: break-all;
    min-width: 0;
    flex: 1;
  }
  .step-url__copy {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-soft);
    background: none;
    border: 1px solid rgba(0, 255, 65, 0.25);
    border-radius: var(--radius-pill, 999px);
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .step-url__copy:hover {
    color: var(--accent);
    border-color: rgba(0, 255, 65, 0.55);
  }

  .tools-list {
    list-style: none;
    padding: 0;
    margin: 1.2rem 0;
    border-top: 1px solid var(--line);
  }
  .tools-list__row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .tools-list__name {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-soft);
    min-width: 12ch;
  }
  .tools-list__desc {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .tools-block__note {
    color: var(--muted-soft);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .tools-block__note code {
    font-family: var(--font-mono);
    font-size: 0.82em;
    color: var(--accent-soft);
  }
</style>
