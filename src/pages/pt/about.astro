---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DitherBg from "../../components/DitherBg.svelte";
import Section from "../../components/Section.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Divider from "../../components/Divider.astro";
import CardAscii from "../../components/CardAscii.svelte";
import WireCard from "../../components/WireCard.astro";
import DitherCover from "../../components/DitherCover.svelte";
import { AEO_UNIQUE_SITES, CAREER_YEARS, formatFact } from "../../lib/site-facts";

const timeline = [
  {
    year: "2025",
    period: "Out 2025 → 2026",
    role: "Senior AI Fullstack Engineer",
    org: "MultiVM Labs",
    location: "Remoto",
    bullets: [
      "Engenheiro frontend core do Quantum, uma L1 pós-quântica. Web app principal + interfaces para developers",
      "Cuido da developer experience do stack: post-quantum-packages (assinatura pós-quântica usável em TS/Rust) e AI tooling (Ralph Starter, Autoresearcher)",
      "Construí o Ralph Starter do zero: orquestrador de código com IA e integrações Figma / GitHub / Linear / Notion (100+ downloads diários no npm)",
      "Criei o AEO.js: Answer Engine Optimization para JS, torna sites descobríveis por ChatGPT, Claude, Perplexity (100+ downloads diários no npm)",
      "Construí o Autoresearcher, um CLI de loop de pesquisa autônoma guiado por benchmark",
      "Construí o Mirofi.sh, deploy de 1 clique para workflows Mirofish",
      "Construí um AI Agent de DeFi na SUI: interface de chat + lógica do agent",
    ],
    stack: ["React", "Next.js", "TypeScript", "Node", "Claude/LLM SDKs", "MCP", "SUI SDK", "EVM", "Tailwind", "Turborepo", "Rust", "Svelte", "Bun"],
  },
  {
    year: "2022",
    period: "Ago 2022 → Set 2025",
    role: "Senior AI Fullstack Engineer",
    org: "Bitte Protocol",
    location: "Remoto",
    bullets: [
      "Construí um trading agent de IA end-to-end com NearIntents + Bitte AI: UI, lógica do agent, pooling de dados em tempo real",
      "Construí o tooling dev-facing pra shippar AI agents: CLI make-agent (valida e deploya um agent de um manifest OpenAPI, com playground instantâneo), o SDK embarcável @bitte-ai/chat, boilerplates de agents e docs",
      "Desenvolvi agents inteligentes e frontends em Solana, EVM, SUI e NEAR: DEXs, launchpads, plataformas DeFi",
      "Contribuidor core da Bitte Wallet: arquitetura de API, UI/UX, extensão Chrome, SDKs NEAR + EVM",
      "Marketplace NFT Mintbase: performance + manutenibilidade com Next.js, GraphQL, React Query",
      "Liderei integrações cross-chain no frontend: solana-web3.js, Viem, Wagmi, Suiet, near-api-js",
      "Open source: melhorei DX + docs do Mintbase.js SDK e dos pacotes Bitte AI",
      "DevOps: pipelines de CI/CD com GitHub Actions + Terraform",
      "Design system: biblioteca de componentes MintbaseUI (React + TypeScript + Tailwind + Storybook)",
    ],
    stack: ["Next.js", "React", "TypeScript", "GraphQL", "Node", "Tailwind", "AI SDK", "MCP", "Wagmi", "Viem", "Solana Kit", "Near.js", "Socket.io", "Turborepo", "Playwright", "Jest", "GCP", "Terraform"],
  },
  {
    year: "2021",
    period: "Set 2021 → Jul 2022",
    role: "Senior Fullstack Engineer",
    org: "Grover",
    location: "Lisboa, Portugal",
    bullets: [
      "Liderei a migração da homepage do app principal de React 16 + Redux legado para Next.js + React Query",
      "Converti todos os assets do site para WebP. Reduzi a carga de recursos em 50%+ mantendo a qualidade visual",
      "Desenhei e entreguei testes A/B, corrigi bugs críticos, puxei aquisição + retenção de usuários",
    ],
    stack: ["Next.js", "React", "Redux", "Vue.js", "TypeScript", "GraphQL", "React Query", "GitHub Actions", "Docker", "Terraform", "Cypress", "RTL", "Jest", "AWS", "Playwright"],
  },
  {
    year: "2019",
    period: "Abr 2019 → Ago 2021",
    role: "Lead Frontend Engineer",
    org: "Zup Innovation",
    location: "São Paulo",
    bullets: [
      "Plataformas financeiras mission-critical para Itaú (maior banco da América Latina) e Santander Espanha",
      "Arquitetei + construí o Developer Portal do Itaú: backend Strapi + Node com frontend Next.js",
      "Desenvolvi app modular de micro-frontends para o StackSpot com Single SPA + React",
      "Implementei solução de biometria facial para verificação em tempo real + avaliação de credit score",
      "Liderança de qualidade de código numa org de 60+ engenheiros: cobertura de testes, code reviews, CI/CD",
      "Liderei um dashboard bancário interno em Vue.js com foco em manutenibilidade + manuseio seguro de dados",
    ],
    stack: ["Next.js", "React", "Redux", "React Query", "TypeScript", "Vue.js", "Node", "Strapi", "GraphQL", "GitHub Actions", "Docker", "Terraform", "Cypress", "Jest", "Single SPA"],
  },
  {
    year: "2018",
    period: "Fev 2018 → Mar 2019",
    role: "Software Engineer",
    org: "GO-K",
    location: "São Paulo",
    bullets: [
      "Construí um marketplace de veículos para o maior grupo logístico do Brasil: canal exclusivo de compra/venda, foco em escalabilidade",
      "Entreguei landing pages + web apps sob medida para vários clientes: velocidade, conversão, SEO",
    ],
    stack: ["Next.js", "React", "Angular", "Vue.js", "TypeScript", "Node", "AWS"],
  },
  {
    year: "2012",
    period: "Mar 2012 → Mar 2017",
    role: "Software Engineer",
    org: "Freelancer",
    location: "São Paulo + mundial",
    bullets: [
      "Software sob medida para clientes Fortune 500 e startups em agências web, publicidade e enterprise",
      "Clientes notáveis: Under Armour, Nike, Centauro, Samsung, Panasonic, Monsanto, Itaú",
      "Construí e-commerces, marketplaces, blogs, portais de conteúdo, landing pages, admin dashboards, sistemas de monitoramento",
    ],
    stack: ["Angular", "JavaScript", "TypeScript", "Vue.js", "React", "Next.js", "PHP", "ASP.NET", "C#"],
  },
];

const skills = [
  { group: "Linguagens",   items: ["TypeScript", "JavaScript", "Rust", "PHP", "C#"] },
  { group: "Frameworks",   items: ["React", "Next.js", "Svelte 5", "Astro", "Vue.js", "Angular", "Node", "Bun"] },
  { group: "AI / agents",  items: ["Claude SDK", "OpenAI SDK", "AI SDK", "MCP", "Ralph loops", "Custom agent tooling"] },
  { group: "Web3",         items: ["EVM", "NEAR", "SUI", "Solana", "Cardano", "Wagmi", "Viem", "Solana Kit", "near-api-js", "Suiet", "ERC-4337"] },
  { group: "Data / API",   items: ["GraphQL", "React Query", "Strapi", "Socket.io", "tRPC"] },
  { group: "Infra / DevOps", items: ["AWS", "GCP", "Vercel", "Docker", "Terraform", "GitHub Actions", "Turborepo"] },
  { group: "Testes",       items: ["Jest", "Playwright", "Cypress", "RTL"] },
  { group: "Design",       items: ["Figma", "Storybook", "Tailwind", "Three.js", "GLSL shaders"] },
];

const education = [
  { school: "FIAP", program: "Sistemas de Informação (Tecnólogo)", period: "Jan 2020 → Jan 2022" },
];
---

<BaseLayout
  lang="pt-br"
  title="Sobre | Ruben Marcus"
  description={`AI Fullstack Engineer Sênior em Lisboa. ${CAREER_YEARS} anos construindo apps escaláveis em web3, fintech e e-commerce.`}
  image="/og/pt-about.png"
>
  <DitherBg client:load opacity={0.55} />
  <Section id="intro" pageHeader>
    <SectionHeader
      level={1}
      index="04"
      overline="Sobre"
      title={`Engenheiro brasileiro, em Lisboa. ${CAREER_YEARS} anos entregando.`}
    />

    <div class="about-grid">
      <div class="about-body" data-reveal>
        <p data-reveal-item>
          Sou um Senior AI Fullstack Engineer com {CAREER_YEARS} anos de experiência construindo
          aplicações escaláveis em web3, fintech e e-commerce. 4+ anos a fundo em Web3 / Crypto,
          2+ anos construindo AI developer tools. Em Lisboa, trabalho para o mundo todo.
        </p>
        <p data-reveal-item>
          Construí 10+ AI agents para protocolos DeFi em Solana, EVM, SUI, NEAR e Cardano.
          Criador do <a href="https://ralphstarter.ai" class="link-inline" target="_blank" rel="noopener">Ralph Starter</a>
          (orquestrador de código com IA) e do <a href="https://aeojs.org" class="link-inline" target="_blank" rel="noopener">AEO.js</a>
          (answer-engine optimisation). Os dois com 100+ downloads diários no npm.
        </p>
        <p data-reveal-item>
          Mais recentemente na <a href="https://multivmlabs.com" class="link-inline" target="_blank" rel="noopener">MultiVM Labs</a>,
          construindo a Quantum, uma blockchain L1. Antes disso, quatro anos em
          NEAR + EVM na Bitte Protocol: wallet, marketplace, trading agents, SDKs cross-chain.
          Antes: lead frontend no developer portal do Itaú (a cara do Open Banking no
          maior banco da América Latina), Grover, e trabalho de agência no Brasil para Nike, Samsung,
          Centauro, Under Armour.
        </p>
        <p data-reveal-item>
          No lado do AEO eu também pego <a href="/pt/contact?subject=aeo" class="link-inline">projetos de AEO</a>:
          escopo fechado, terminando com um relatório de antes/depois do
          <a href="https://check.aeojs.org" class="link-inline" target="_blank" rel="noopener">check.aeojs.org</a>
          ({formatFact(AEO_UNIQUE_SITES, "pt-BR")} sites únicos escaneados e contando).
        </p>
        <p data-reveal-item>
          Eu me importo com as costuras: como spec vira código, como pesquisa vira produto,
          como uma UI se sente quando um agent é dono de metade dela. Seletivamente
          disponível para AI tooling, agents e trabalho em Web3.
        </p>
      </div>

      <aside class="about-card" data-reveal>
        <div class="about-card__photo">
          <DitherCover
            client:visible
            src="/art/about-portrait.png"
            seed="Ruben Marcus"
            alt="Ruben Marcus"
            class="about-card__portrait"
            invert
          />
        </div>
        <div class="about-card__meta">
          <span class="bracket">Resumo</span>
          <dl>
            <div><dt>Nome completo</dt><dd>Ruben Marcus Luz Paschoarelli</dd></div>
            <div><dt>Base</dt><dd>Lisboa, Portugal</dd></div>
            <div><dt>Cargo</dt><dd>Sr. AI Fullstack Engineer</dd></div>
            <div><dt>Anos</dt><dd>13 (4+ web3, 2+ AI tools)</dd></div>
            <div><dt>CV</dt><dd><a href="/cv.pdf" class="link-inline" target="_blank" rel="noopener">Baixar PDF ↓</a></dd></div>
            <div><dt>Telefone</dt><dd>+351 912 892 825</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  </Section>

  <Divider index="04.1" label="Trajetória" />

  <Section id="timeline" tight>
    <ol class="timeline" data-reveal>
      {timeline.map((t) => (
        <li data-reveal-item>
          <WireCard class="timeline-row" glyph={t.year}>
            <div class="timeline-meta">
              <span class="timeline-year">{t.year}</span>
              <span class="timeline-period">{t.period}</span>
              <span class="timeline-location">{t.location}</span>
            </div>
            <div class="timeline-body">
              <div class="timeline-head">
                <span class="timeline-role">{t.role}</span>
                <span class="timeline-org">{t.org}</span>
              </div>
              <ul class="timeline-bullets">
                {t.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <div class="timeline-stack">
                {t.stack.map((s) => <span class="timeline-tag">{s}</span>)}
              </div>
            </div>
          </WireCard>
        </li>
      ))}
    </ol>
  </Section>

  <Divider index="04.3" label="Skills" />

  <Section id="skills" tight>
    <div class="skills-grid" data-reveal>
      {skills.map((s, i) => (
        <div class="skills-col" data-reveal-item>
          <CardAscii client:visible seed={`skill-${s.group}`} variant={(["noise","wave","block"] as const)[i % 3]} cols={9} rows={4} />
          <span class="bracket skills-label">{s.group}</span>
          <ul>
            {s.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Divider index="04.4" label="Educação" />

  <Section id="education" tight>
    <ul class="edu-list" data-reveal>
      {education.map((e) => (
        <li class="edu-row" data-reveal-item>
          <span class="edu-school">{e.school}</span>
          <span class="edu-program">{e.program}</span>
          <span class="edu-period">{e.period}</span>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .about-grid { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .about-body p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 64ch;
  }

  .about-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: rgba(6, 8, 15, 0.6);
    backdrop-filter: blur(var(--blur-sm));
    -webkit-backdrop-filter: blur(var(--blur-sm));
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-card__photo {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  /* Generated particle portrait (scripts/gen-about-portrait.mjs) through the
     same DitherCover as every other card: portrait at rest, dots on hover. */
  .about-card__photo :global(.about-card__portrait) {
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: 12px;
  }

  .about-card__meta dl {
    display: grid;
    gap: 0.6rem;
    margin: 0.55rem 0 0;
  }
  .about-card__meta dl > div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 0.6rem;
  }
  .about-card__meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .about-card__meta dd {
    color: var(--text);
    margin: 0;
    font-size: 0.9rem;
  }

  /* Timeline — entries as wire cards */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .timeline :global(.timeline-row) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .timeline :global(.timeline-row) { grid-template-columns: 200px 1fr; gap: 2rem; }
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .timeline-year {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--accent-soft);
  }
  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .timeline-location {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-soft);
  }

  .timeline-body { display: flex; flex-direction: column; gap: 0.7rem; }
  .timeline-head { display: flex; flex-wrap: wrap; gap: 0.4rem 0.85rem; align-items: baseline; }
  .timeline-role { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.15; color: var(--text); }
  .timeline-org { font-family: var(--font-mono); font-size: 0.74rem; color: var(--accent-soft); text-transform: uppercase; letter-spacing: 0.08em; }

  .timeline-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .timeline-bullets li {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    padding-left: 1.2rem;
    position: relative;
  }
  .timeline-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent-soft);
  }

  .timeline-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.4rem;
    margin-top: 0.3rem;
  }
  .timeline-tag {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted-soft);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1fr 1fr;
  }
  @media (min-width: 720px) { .skills-grid { grid-template-columns: repeat(4, 1fr); } }

  .skills-col {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: rgba(6, 8, 15, 0.5);
    backdrop-filter: blur(var(--blur-sm));
    -webkit-backdrop-filter: blur(var(--blur-sm));
  }
  .skills-label { color: var(--muted); }

  .skills-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }
  .skills-col li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text);
  }

  /* Education */
  .edu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .edu-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .edu-row { grid-template-columns: 200px 1fr auto; gap: 1.2rem; align-items: baseline; }
  }
  .edu-school {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--text);
  }
  .edu-program { color: var(--muted); font-size: 0.95rem; }
  .edu-period { font-family: var(--font-mono); font-size: 0.74rem; color: var(--muted-soft); }
</style>
