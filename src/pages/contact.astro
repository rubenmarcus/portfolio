---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import AsciiField from "../components/AsciiField.svelte";
import CardAscii from "../components/CardAscii.svelte";
import Icon from "../components/Icon.astro";
import { socialLinks } from "../lib/navigation";

const iconMap: Record<string, "github" | "x-twitter" | "linkedin" | "mail" | "telegram" | "dev-to"> = {
  GitHub: "github",
  X: "x-twitter",
  LinkedIn: "linkedin",
  Email: "mail",
  Telegram: "telegram",
  "dev.to": "dev-to",
};
---

<BaseLayout
  title="Contact — Ruben Marcus"
  description="Get in touch with Ruben Marcus. Selectively available for AI tooling, Web3, and post-quantum work."
>
  <!-- Atmospheric ASCII field -->
  <div class="contact-atmos" aria-hidden="true">
    <AsciiField client:load cell={22} density={0.14} morphRate={1.0} opacity={0.32} reactive={true} />
  </div>

  <Section id="intro">
    <SectionHeader
      index="05"
      overline="Contact"
      title="Let's talk."
      description="Selectively available for AI tooling, Web3, and post-quantum infrastructure work. Email is the fastest channel — I usually reply within a day or two."
    />

    <div class="contact-grid">
      <a href="mailto:rubenmarcus.dev@gmail.com" class="contact-card contact-card--primary" data-reveal>
        <CardAscii client:visible seed="contact-primary" variant="wave" cols={12} rows={5} />
        <div class="contact-card__head">
          <span class="bracket">Primary</span>
          <Icon name="arrow-up-right" size={18} class="contact-card__arrow" />
        </div>
        <div class="contact-card__valueRow">
          <Icon name="mail" size={22} class="contact-card__icon" />
          <span class="contact-card__value">rubenmarcus.dev@gmail.com</span>
        </div>
        <span class="contact-card__note">Best for project inquiries, longer-form questions, or anything off-public. I usually reply within a day.</span>
      </a>

      <a href="tel:+351912892825" class="contact-card contact-card--phone" data-reveal>
        <div class="contact-card__head">
          <span class="bracket">Phone</span>
          <Icon name="arrow-up-right" size={18} class="contact-card__arrow" />
        </div>
        <div class="contact-card__valueRow">
          <Icon name="telegram" size={22} class="contact-card__icon" />
          <span class="contact-card__value">+351 912 892 825</span>
        </div>
        <span class="contact-card__note">Lisbon, Portugal. WhatsApp / Telegram fine on this number.</span>
      </a>

      <div class="contact-card" data-reveal>
        <CardAscii client:visible seed="contact-public" variant="block" cols={12} rows={5} />
        <div class="contact-card__head">
          <span class="bracket">Public channels</span>
        </div>
        <ul class="contact-socials">
          {socialLinks.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" class="contact-social">
                <span class="contact-social__icon">
                  <Icon name={iconMap[s.label] ?? "external"} size={16} />
                </span>
                <span>{s.label}</span>
                <span class="contact-social__url">{s.href.replace("https://", "").replace("mailto:", "")}</span>
                <Icon name="arrow-up-right" size={14} class="contact-card__arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="contact-note" data-reveal>
      <span class="bracket" data-reveal-item>A heads up</span>
      <p data-reveal-item>
        I'm intentionally selective with new engagements right now — most of my week goes to
        MultiVM Labs and the Ralph / Autoresearcher / AEO tooling. If you're building something
        in autonomous agents, post-quantum infrastructure, or interesting on-chain product, please
        do reach out. If you need a generic frontend body for hire, I'm probably not your fit.
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ASCII atmosphere — fixed, masked to keep content readable */
  .contact-atmos {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at 50% 35%, transparent 22%, #000 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 35%, transparent 22%, #000 75%);
  }

  .contact-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    margin-bottom: 2rem;
  }
  @media (min-width: 720px) { .contact-grid { grid-template-columns: 1fr 1fr; } }

  .contact-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    background: var(--bg-1);
    color: var(--text);
    transition:
      border-color var(--duration-hover) var(--ease-default),
      background-color var(--duration-hover) var(--ease-default),
      transform var(--duration-hover) var(--ease-default);
  }
  .contact-card:hover {
    border-color: var(--line-bright);
    transform: translateY(-2px);
    background: var(--bg-2);
  }

  .contact-card--primary { background: linear-gradient(180deg, rgba(58, 109, 255, 0.07), rgba(58, 109, 255, 0.02)); border-color: rgba(58, 109, 255, 0.26); }
  .contact-card--primary:hover { border-color: rgba(58, 109, 255, 0.5); }

  .contact-card--phone { background: linear-gradient(180deg, rgba(160, 195, 255, 0.045), rgba(160, 195, 255, 0.015)); }

  .contact-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--muted);
  }

  .contact-card__valueRow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .contact-card__value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.05;
  }

  :global(.contact-card__icon) { color: var(--accent-soft); }

  .contact-card__note {
    color: var(--muted);
    font-size: 0.9rem;
  }

  :global(.contact-card__arrow) {
    color: var(--muted-soft);
    transition: transform var(--duration-hover) var(--ease-default), color var(--duration-hover) var(--ease-default);
  }
  .contact-card:hover :global(.contact-card__arrow) {
    transform: translate(2px, -2px);
    color: var(--accent-soft);
  }

  .contact-socials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .contact-social {
    display: grid;
    grid-template-columns: 24px 100px 1fr auto;
    gap: 0.7rem;
    align-items: center;
    padding: 0.7rem 0;
    border-top: 1px solid var(--line);
    color: var(--text);
    transition: color var(--duration-hover) var(--ease-default);
  }
  .contact-social:hover { color: var(--accent-soft); }
  .contact-socials li:first-child .contact-social { border-top: none; padding-top: 0; }

  .contact-social__icon {
    color: var(--accent-soft);
    display: inline-grid;
    place-items: center;
  }

  .contact-social__url {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .contact-note {
    margin-top: 1rem;
    padding: 1.5rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .contact-note p {
    color: var(--muted);
    max-width: 68ch;
    line-height: 1.65;
  }
</style>

<script>
  import { reveal } from "../lib/motion/reveal";
  const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            reveal(e.target as HTMLElement);
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
