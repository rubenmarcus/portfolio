---
// Dev-only decision page — NOT linked from nav. Compares the 4 Mint-generated
// hero key visuals, each shown raw and with its production animation treatment.
const candidates = [
  {
    id: "imposter",
    file: "/art/hero-imposter.png",
    title: "A · Imposter (pastel 3D editorial)",
    desc: "Pixar-grade 3D portrait, pastel gradient sky, negative space for type. Ken Burns + gradient drift.",
    treatment: "kenburns",
    landscape: true,
  },
  {
    id: "dither",
    file: "/art/hero-dither.png",
    title: "B · Dither (green halftone)",
    desc: "Ordered-dither halftone portrait, terminal green on black. Breathing threshold pulse.",
    treatment: "dither",
    landscape: false,
  },
  {
    id: "ascii",
    file: "/art/hero-ascii.png",
    title: "C · ASCII (terminal portrait)",
    desc: "Face built from monospace glyphs, terminal chrome. Region flicker + scanline.",
    treatment: "ascii",
    landscape: true,
  },
  {
    id: "wireframe",
    file: "/art/hero-wireframe.png",
    title: "D · Wireframe (Tron lines)",
    desc: "Glowing green wireframe, side profile at laptop, vaporwave grid. Glow pulse + slow vertical pan.",
    treatment: "wireframe",
    landscape: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Art direction preview — hero candidates</title>
    <style>
      :root {
        --bg: #0a0a0a;
        --panel: #111;
        --line: #222;
        --green: #00ff41;
        --dim: #888;
        --text: #e8e8e8;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        padding: 48px 24px 96px;
      }
      header { max-width: 1200px; margin: 0 auto 48px; }
      h1 { font-size: 20px; font-weight: 600; letter-spacing: 0.02em; }
      header p { color: var(--dim); font-size: 13px; margin-top: 8px; line-height: 1.6; }
      .grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        gap: 40px;
      }
      .card {
        border: 1px solid var(--line);
        background: var(--panel);
        border-radius: 8px;
        overflow: hidden;
      }
      .card__head { padding: 16px 20px 0; }
      .card__head h2 { font-size: 15px; color: var(--green); font-weight: 600; }
      .card__head p { color: var(--dim); font-size: 12px; margin-top: 6px; line-height: 1.5; }
      .pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: var(--line);
        margin-top: 16px;
        border-top: 1px solid var(--line);
      }
      @media (max-width: 800px) { .pair { grid-template-columns: 1fr; } }
      .pane { position: relative; background: #000; }
      .pane__tag {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 5;
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #000;
        background: var(--green);
        padding: 2px 6px;
        border-radius: 3px;
      }
      .frame {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #000;
      }
      .frame img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .frame--portrait img { object-fit: cover; object-position: center 20%; }

      /* ---------- A · imposter: Ken Burns + gradient drift ---------- */
      .fx-kenburns img { animation: kb 20s ease-in-out infinite alternate; }
      @keyframes kb {
        from { transform: scale(1) translate(0, 0); }
        to { transform: scale(1.06) translate(-1.2%, -1.6%); }
      }
      .fx-kenburns::after {
        content: "";
        position: absolute;
        inset: -20%;
        background: linear-gradient(
          115deg,
          rgba(255, 170, 200, 0.14),
          rgba(170, 150, 255, 0.1) 40%,
          rgba(255, 210, 170, 0.12) 75%,
          transparent
        );
        mix-blend-mode: screen;
        animation: drift 14s ease-in-out infinite alternate;
        pointer-events: none;
      }
      @keyframes drift {
        from { transform: translate(-6%, -4%) rotate(-2deg); }
        to { transform: translate(6%, 4%) rotate(2deg); }
      }

      /* ---------- B · dither: breathing threshold ---------- */
      .fx-dither img { animation: breathe 5s ease-in-out infinite; }
      @keyframes breathe {
        0%, 100% { filter: contrast(1) brightness(1); transform: scale(1); opacity: 1; }
        50% { filter: contrast(1.18) brightness(1.12); transform: scale(1.012); opacity: 0.94; }
      }
      .fx-dither::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 40%, transparent 55%, rgba(0, 0, 0, 0.55));
        animation: vign 5s ease-in-out infinite;
        pointer-events: none;
      }
      @keyframes vign { 0%, 100% { opacity: 0.7; } 50% { opacity: 1; } }

      /* ---------- C · ascii: region flicker + scanline ---------- */
      .fx-ascii img.dup { opacity: 0; }
      .fx-ascii img.r1 { clip-path: inset(8% 55% 60% 5%); animation: flick 3.1s steps(2, end) infinite; }
      .fx-ascii img.r2 { clip-path: inset(30% 10% 35% 60%); animation: flick 4.3s steps(2, end) infinite 0.7s; }
      .fx-ascii img.r3 { clip-path: inset(62% 40% 8% 30%); animation: flick 2.6s steps(2, end) infinite 1.4s; }
      @keyframes flick {
        0%, 88% { opacity: 0; }
        89%, 93% { opacity: 0.55; filter: brightness(1.6) hue-rotate(8deg); }
        94%, 100% { opacity: 0; }
      }
      .fx-ascii::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        height: 22%;
        top: -25%;
        background: linear-gradient(
          to bottom,
          transparent,
          rgba(0, 255, 65, 0.08) 45%,
          rgba(0, 255, 65, 0.22) 50%,
          rgba(0, 255, 65, 0.08) 55%,
          transparent
        );
        animation: scan 4.5s linear infinite;
        pointer-events: none;
      }
      @keyframes scan { from { transform: translateY(0); } to { transform: translateY(680%); } }

      /* ---------- D · wireframe: glow pulse + slow vertical pan ---------- */
      .fx-wireframe img {
        height: 118%;
        animation: glowpan 12s ease-in-out infinite alternate;
      }
      @keyframes glowpan {
        from { filter: brightness(1) drop-shadow(0 0 6px rgba(0, 255, 65, 0.25)); transform: translateY(0); }
        to { filter: brightness(1.25) drop-shadow(0 0 16px rgba(0, 255, 65, 0.55)); transform: translateY(-13%); }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; }
        .fx-ascii img.dup { opacity: 0 !important; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Hero art direction — 4 candidates</h1>
      <p>
        Dev-only decision page (not in nav). Left: raw still as generated. Right: the same image
        with the live treatment it would get in production. All honor
        <code>prefers-reduced-motion</code>.
      </p>
    </header>
    <div class="grid">
      {candidates.map((c) => (
        <section class="card">
          <div class="card__head">
            <h2>{c.title}</h2>
            <p>{c.desc}</p>
          </div>
          <div class="pair">
            <div class="pane">
              <span class="pane__tag">still</span>
              <div class:list={["frame", { "frame--portrait": !c.landscape }]}>
                <img src={c.file} alt={`${c.id} still`} loading="lazy" />
              </div>
            </div>
            <div class="pane">
              <span class="pane__tag">treated</span>
              <div class:list={["frame", `fx-${c.treatment}`, { "frame--portrait": !c.landscape }]}>
                <img src={c.file} alt={`${c.id} treated`} loading="lazy" />
                {c.treatment === "ascii" && (
                  <>
                    <img class="dup r1" src={c.file} alt="" aria-hidden="true" />
                    <img class="dup r2" src={c.file} alt="" aria-hidden="true" />
                    <img class="dup r3" src={c.file} alt="" aria-hidden="true" />
                  </>
                )}
              </div>
            </div>
          </div>
        </section>
      ))}
    </div>
  </body>
</html>
