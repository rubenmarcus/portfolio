---
import BaseLayout from "../layouts/BaseLayout.astro";
import DitherBg from "../components/DitherBg.svelte";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Divider from "../components/Divider.astro";
import CardAscii from "../components/CardAscii.svelte";
import WireCard from "../components/WireCard.astro";
import DitherCover from "../components/DitherCover.svelte";
import { AEO_UNIQUE_SITES, CAREER_YEARS, formatFact } from "../lib/site-facts";

const timeline = [
  {
    year: "2025",
    period: "Oct 2025 → 2026",
    role: "Senior AI Fullstack Engineer",
    org: "MultiVM Labs",
    location: "Remote",
    bullets: [
      "Core frontend engineer for Quantum, a post-quantum secure L1. Main web app + developer-facing interfaces",
      "Own developer experience across the stack: post-quantum-packages (making PQ signing usable from TS/Rust) and AI tooling (Ralph Starter, Autoresearcher)",
      "Built Ralph Starter from scratch: AI coding orchestrator with Figma / GitHub / Linear / Notion integrations (190+ npm downloads a month)",
      "Created AEO.js: Answer Engine Optimization for JS, makes sites discoverable by ChatGPT, Claude, Perplexity (1,300+ npm downloads a month)",
      "Built Autoresearcher, a benchmark-driven autonomous research loop CLI",
      "Built Mirofi.sh, a 1-click deployment for Mirofish workflows",
      "Built a SUI AI Agent for DeFi on SUI: chat interface + agent logic",
    ],
    stack: ["React", "Next.js", "TypeScript", "Node", "Claude/LLM SDKs", "MCP", "SUI SDK", "EVM", "Tailwind", "Turborepo", "Rust", "Svelte", "Bun"],
  },
  {
    year: "2022",
    period: "Aug 2022 → Sep 2025",
    role: "Senior AI Fullstack Engineer",
    org: "Bitte Protocol",
    location: "Remote",
    bullets: [
      "Built an end-to-end AI trading agent on NearIntents + Bitte AI: UI, agent logic, real-time data pooling",
      "Built the dev-facing tooling for shipping AI agents: make-agent CLI (validate + deploy an agent from an OpenAPI manifest, instant playground), the @bitte-ai/chat embeddable SDK, agent boilerplates and docs",
      "Developed intelligent agents and frontends across Solana, EVM, SUI, and NEAR: DEXs, launchpads, DeFi platforms",
      "Core contributor on Bitte Wallet: API architecture, UI/UX, Chrome extension, NEAR + EVM SDKs",
      "Mintbase NFT marketplace: performance + maintainability with Next.js, GraphQL, React Query",
      "Led frontend cross-chain integrations: solana-web3.js, Viem, Wagmi, Suiet, near-api-js",
      "Open source: improved Mintbase.js SDK and Bitte AI packages DX + docs",
      "DevOps: CI/CD pipelines with GitHub Actions + Terraform",
      "Design system: MintbaseUI component library (React + TypeScript + Tailwind + Storybook)",
    ],
    stack: ["Next.js", "React", "TypeScript", "GraphQL", "Node", "Tailwind", "AI SDK", "MCP", "Wagmi", "Viem", "Solana Kit", "Near.js", "Socket.io", "Turborepo", "Playwright", "Jest", "GCP", "Terraform"],
  },
  {
    year: "2021",
    period: "Sep 2021 → Jul 2022",
    role: "Senior Fullstack Engineer",
    org: "Grover",
    location: "Lisbon, Portugal",
    bullets: [
      "Led migration of the main app homepage from legacy React 16 + Redux to Next.js + React Query",
      "Converted all site assets to WebP. Reduced resource load by 50%+ while keeping visual quality",
      "Designed and shipped A/B tests, fixed critical bugs, drove user acquisition + retention",
    ],
    stack: ["Next.js", "React", "Redux", "Vue.js", "TypeScript", "GraphQL", "React Query", "GitHub Actions", "Docker", "Terraform", "Cypress", "RTL", "Jest", "AWS", "Playwright"],
  },
  {
    year: "2019",
    period: "Apr 2019 → Aug 2021",
    role: "Lead Frontend Engineer",
    org: "Zup Innovation",
    location: "São Paulo",
    bullets: [
      "Mission-critical financial platforms for Itaú (largest bank in Latin America) and Santander Spain",
      "Architected + built Itaú's Developer Portal: Strapi + Node backend with Next.js frontend",
      "Developed modular micro-frontend app for StackSpot using Single SPA + React",
      "Implemented facial biometric solution for real-time verification + credit score evaluation",
      "Code quality leadership in a 60+ engineer org: test coverage, code reviews, CI/CD",
      "Led an internal Vue.js banking dashboard with focus on maintainability + secure data handling",
    ],
    stack: ["Next.js", "React", "Redux", "React Query", "TypeScript", "Vue.js", "Node", "Strapi", "GraphQL", "GitHub Actions", "Docker", "Terraform", "Cypress", "Jest", "Single SPA"],
  },
  {
    year: "2018",
    period: "Feb 2018 → Mar 2019",
    role: "Software Engineer",
    org: "GO-K",
    location: "São Paulo",
    bullets: [
      "Built a vehicle marketplace for Brazil's largest logistics group: exclusive buy/sell channel, focus on scalability",
      "Delivered landing pages + custom web apps for multiple clients: speed, conversion, SEO",
    ],
    stack: ["Next.js", "React", "Angular", "Vue.js", "TypeScript", "Node", "AWS"],
  },
  {
    year: "2012",
    period: "Mar 2012 → Mar 2017",
    role: "Software Engineer",
    org: "Freelancer",
    location: "São Paulo + worldwide",
    bullets: [
      "Custom software for Fortune 500 clients and startups across web agencies, advertising, and enterprise",
      "Notable clients: Under Armour, Nike, Centauro, Samsung, Panasonic, Monsanto, Itaú",
      "Built e-commerce, marketplaces, blogs, content portals, landing pages, admin dashboards, monitoring systems",
    ],
    stack: ["Angular", "JavaScript", "TypeScript", "Vue.js", "React", "Next.js", "PHP", "ASP.NET", "C#"],
  },
];

const skills = [
  { group: "Languages",    items: ["TypeScript", "JavaScript", "Rust", "PHP", "C#"] },
  { group: "Frameworks",   items: ["React", "Next.js", "Svelte 5", "Astro", "Vue.js", "Angular", "Node", "Bun"] },
  { group: "AI / agents",  items: ["Claude SDK", "OpenAI SDK", "AI SDK", "MCP", "Ralph loops", "Custom agent tooling"] },
  { group: "Web3",         items: ["EVM", "NEAR", "SUI", "Solana", "Cardano", "Wagmi", "Viem", "Solana Kit", "near-api-js", "Suiet", "ERC-4337"] },
  { group: "Data / API",   items: ["GraphQL", "React Query", "Strapi", "Socket.io", "tRPC"] },
  { group: "Infra / DevOps", items: ["AWS", "GCP", "Vercel", "Docker", "Terraform", "GitHub Actions", "Turborepo"] },
  { group: "Testing",      items: ["Jest", "Playwright", "Cypress", "RTL"] },
  { group: "Design",       items: ["Figma", "Storybook", "Tailwind", "Three.js", "GLSL shaders"] },
];

const education = [
  { school: "FIAP", program: "Information Systems (Associate)", period: "Jan 2020 → Jan 2022" },
];
---

<BaseLayout
  title="About | Ruben Marcus"
  description={`Senior AI Fullstack Engineer based in Lisbon. ${CAREER_YEARS} years building scalable apps across web3, fintech, and e-commerce.`}
  image="/og/about.png"
>
  <DitherBg client:load opacity={0.55} />
  <Section id="intro" pageHeader>
    <SectionHeader
      level={1}
      index="04"
      overline="About"
      title={`Brazilian engineer, Lisbon-based. ${CAREER_YEARS} years shipping.`}
    />

    <div class="about-grid">
      <div class="about-body" data-reveal>
        <p data-reveal-item>
          I'm a Senior AI Fullstack Engineer with {CAREER_YEARS} years of experience building scalable
          applications across web3, fintech, and e-commerce. 4+ years deep in Web3 / Crypto,
          2+ years building AI developer tools. Based in Lisbon, work worldwide.
        </p>
        <p data-reveal-item>
          Built 10+ AI agents for DeFi protocols across Solana, EVM, SUI, NEAR, and Cardano.
          Creator of <a href="https://ralphstarter.ai" class="link-inline" target="_blank" rel="noopener">Ralph Starter</a>
          (AI coding orchestrator) and <a href="https://aeojs.org" class="link-inline" target="_blank" rel="noopener">AEO.js</a>
          (answer-engine optimisation). Together they do about 1,500 npm downloads a month.
        </p>
        <p data-reveal-item>
          Most recently at <a href="https://multivmlabs.com" class="link-inline" target="_blank" rel="noopener">MultiVM Labs</a>,
          building Quantum, an L1 blockchain. Before that, four years on
          NEAR + EVM at Bitte Protocol: wallet, marketplace, trading agents, cross-chain SDKs.
          Earlier: lead frontend on Itaú's developer portal (the face of Open Banking at the
          largest bank in Latin America), Grover, and Brazilian agency work for Nike, Samsung,
          Centauro, Under Armour.
        </p>
        <p data-reveal-item>
          On the AEO side I also take on <a href="/contact?subject=aeo" class="link-inline">AEO engagements</a>:
          fixed-scope projects that end with a before/after score report from
          <a href="https://check.aeojs.org" class="link-inline" target="_blank" rel="noopener">check.aeojs.org</a>
          ({formatFact(AEO_UNIQUE_SITES, "en-US")} unique sites scanned and counting).
        </p>
        <p data-reveal-item>
          I care about the seams: how spec becomes code, how research becomes a product,
          how a UI feels when an agent owns half of it. Selectively available for AI tooling,
          agents, and Web3 work.
        </p>
      </div>

      <aside class="about-card" data-reveal>
        <div class="about-card__photo">
          <DitherCover
            client:visible
            src="/art/about-portrait.png"
            seed="Ruben Marcus"
            alt="Ruben Marcus"
            class="about-card__portrait"
            invert
          />
        </div>
        <div class="about-card__meta">
          <span class="bracket">At a glance</span>
          <dl>
            <div><dt>Full name</dt><dd>Ruben Marcus Luz Paschoarelli</dd></div>
            <div><dt>Based</dt><dd>Lisbon, Portugal</dd></div>
            <div><dt>Role</dt><dd>Sr. AI Fullstack Engineer</dd></div>
            <div><dt>Years</dt><dd>13 (4+ web3, 2+ AI tools)</dd></div>
            <div><dt>CV</dt><dd><a href="/cv.pdf" class="link-inline" target="_blank" rel="noopener">Download PDF ↓</a></dd></div>
            <div><dt>Phone</dt><dd>+351 912 892 825</dd></div>
          </dl>
        </div>
      </aside>
    </div>
  </Section>

  <Divider index="04.1" label="Timeline" />

  <Section id="timeline" tight>
    <ol class="timeline" data-reveal>
      {timeline.map((t) => (
        <li data-reveal-item>
          <WireCard class="timeline-row" glyph={t.year}>
            <div class="timeline-meta">
              <span class="timeline-year">{t.year}</span>
              <span class="timeline-period">{t.period}</span>
              <span class="timeline-location">{t.location}</span>
            </div>
            <div class="timeline-body">
              <div class="timeline-head">
                <span class="timeline-role">{t.role}</span>
                <span class="timeline-org">{t.org}</span>
              </div>
              <ul class="timeline-bullets">
                {t.bullets.map((b) => <li>{b}</li>)}
              </ul>
              <div class="timeline-stack">
                {t.stack.map((s) => <span class="timeline-tag">{s}</span>)}
              </div>
            </div>
          </WireCard>
        </li>
      ))}
    </ol>
  </Section>

  <Divider index="04.3" label="Skills" />

  <Section id="skills" tight>
    <div class="skills-grid" data-reveal>
      {skills.map((s, i) => (
        <div class="skills-col" data-reveal-item>
          <CardAscii client:visible seed={`skill-${s.group}`} variant={(["noise","wave","block"] as const)[i % 3]} cols={9} rows={4} />
          <span class="bracket skills-label">{s.group}</span>
          <ul>
            {s.items.map((it) => <li>{it}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Divider index="04.4" label="Education" />

  <Section id="education" tight>
    <ul class="edu-list" data-reveal>
      {education.map((e) => (
        <li class="edu-row" data-reveal-item>
          <span class="edu-school">{e.school}</span>
          <span class="edu-program">{e.program}</span>
          <span class="edu-period">{e.period}</span>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .about-grid { grid-template-columns: 1.4fr 1fr; gap: 4rem; }
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .about-body p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 64ch;
  }

  .about-card {
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 1rem;
    background: rgba(6, 8, 15, 0.6);
    backdrop-filter: blur(var(--blur-sm));
    -webkit-backdrop-filter: blur(var(--blur-sm));
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-card__photo {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
  }

  /* Generated particle portrait (scripts/gen-about-portrait.mjs) through the
     same DitherCover as every other card: portrait at rest, dots on hover. */
  .about-card__photo :global(.about-card__portrait) {
    aspect-ratio: 1 / 1;
    width: 100%;
    border-radius: 12px;
  }

  .about-card__meta dl {
    display: grid;
    gap: 0.6rem;
    margin: 0.55rem 0 0;
  }
  .about-card__meta dl > div {
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 0.6rem;
  }
  .about-card__meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .about-card__meta dd {
    color: var(--text);
    margin: 0;
    font-size: 0.9rem;
  }

  /* Timeline — entries as wire cards */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .timeline :global(.timeline-row) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .timeline :global(.timeline-row) { grid-template-columns: 200px 1fr; gap: 2rem; }
  }

  .timeline-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .timeline-year {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--accent-soft);
  }
  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .timeline-location {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted-soft);
  }

  .timeline-body { display: flex; flex-direction: column; gap: 0.7rem; }
  .timeline-head { display: flex; flex-wrap: wrap; gap: 0.4rem 0.85rem; align-items: baseline; }
  .timeline-role { font-family: var(--font-display); font-size: 1.4rem; line-height: 1.15; color: var(--text); }
  .timeline-org { font-family: var(--font-mono); font-size: 0.74rem; color: var(--accent-soft); text-transform: uppercase; letter-spacing: 0.08em; }

  .timeline-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .timeline-bullets li {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
    padding-left: 1.2rem;
    position: relative;
  }
  .timeline-bullets li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--accent-soft);
  }

  .timeline-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.4rem;
    margin-top: 0.3rem;
  }
  .timeline-tag {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted-soft);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: 1fr 1fr;
  }
  @media (min-width: 720px) { .skills-grid { grid-template-columns: repeat(4, 1fr); } }

  .skills-col {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: rgba(6, 8, 15, 0.5);
    backdrop-filter: blur(var(--blur-sm));
    -webkit-backdrop-filter: blur(var(--blur-sm));
  }
  .skills-label { color: var(--muted); }

  .skills-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }
  .skills-col li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text);
  }

  /* Education */
  .edu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .edu-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 720px) {
    .edu-row { grid-template-columns: 200px 1fr auto; gap: 1.2rem; align-items: baseline; }
  }
  .edu-school {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    color: var(--text);
  }
  .edu-program { color: var(--muted); font-size: 0.95rem; }
  .edu-period { font-family: var(--font-mono); font-size: 0.74rem; color: var(--muted-soft); }
</style>
