---
/**
 * WireCard — the site's shared crafted container: a near-black panel with a
 * 1px terminal-green hairline border, corner-bracket accents (same language
 * as the portfolio rows), a faint dot-grid + ASCII-glyph watermark in the
 * corner, and a hover state (border brightens, sheen sweep from global.css).
 *
 * Usage: wrap any content; pass `href` to render the whole card as a link.
 */
interface Props {
  class?: string;
  /** Renders the card as an <a> when set. */
  href?: string;
  target?: string;
  rel?: string;
  /** ASCII glyph watermarked in the bottom-right corner. */
  glyph?: string;
}

const { class: className = "", href, target, rel, glyph, ...rest }: Props = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class:list={["wire-card", className]} href={href} target={target} rel={rel} {...rest}>
  <span class="wire-card__mark" aria-hidden="true">{glyph ?? ">"}</span>
  <slot />
</Tag>

<style>
  .wire-card {
    position: relative;
    overflow: hidden;
    display: block;
    padding: 1.6rem;
    border: 1px solid rgba(0, 255, 65, 0.14);
    border-radius: var(--radius-card);
    background-color: rgba(3, 6, 5, 0.62);
    color: var(--text);
    transition:
      border-color var(--duration-hover) var(--ease-default),
      box-shadow var(--duration-hover) var(--ease-default),
      transform var(--duration-hover) var(--ease-default);
  }

  /* Corner brackets — four green L-corners framing the panel */
  .wire-card::before {
    content: "";
    position: absolute;
    inset: 6px;
    pointer-events: none;
    opacity: 0.4;
    transition: opacity var(--duration-hover) var(--ease-default);
    background-image:
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent)),
      linear-gradient(var(--accent), var(--accent));
    background-size:
      14px 1px, 1px 14px,
      14px 1px, 1px 14px,
      14px 1px, 1px 14px,
      14px 1px, 1px 14px;
    background-position:
      left top, left top,
      right top, right top,
      left bottom, left bottom,
      right bottom, right bottom;
    background-repeat: no-repeat;
  }

  /* Dot-grid + ASCII-glyph watermark in the bottom-right corner */
  .wire-card__mark {
    position: absolute;
    right: 0.7rem;
    bottom: 0.35rem;
    padding: 0.4rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 1.5rem;
    line-height: 1;
    color: rgba(0, 255, 65, 0.22);
    pointer-events: none;
    background-image: radial-gradient(circle, rgba(74, 222, 128, 0.12) 1px, transparent 1px);
    background-size: 9px 9px;
    mask-image: radial-gradient(ellipse at 100% 100%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 100% 100%, #000 30%, transparent 75%);
  }

  .wire-card:hover {
    border-color: rgba(0, 255, 65, 0.42);
    box-shadow:
      0 0 0 1px rgba(0, 255, 65, 0.1),
      0 14px 40px rgba(0, 0, 0, 0.5);
  }
  .wire-card:hover::before {
    opacity: 0.95;
    filter: drop-shadow(0 0 6px rgba(0, 255, 65, 0.4));
  }

  @media (prefers-reduced-motion: reduce) {
    .wire-card,
    .wire-card::before {
      transition: none;
    }
  }
</style>
