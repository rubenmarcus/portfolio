---
interface Props {
  href?: string;
  variant?: "default" | "borderless";
  class?: string;
  target?: string;
}

const { href, variant = "default", class: className = "", target } = Astro.props;
const baseClass = variant === "borderless" ? "card-borderless" : "card";
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class:list={[baseClass, className]}
  target={href ? target : undefined}
  rel={href && target === "_blank" ? "noopener noreferrer" : undefined}
>
  <slot />
</Tag>
