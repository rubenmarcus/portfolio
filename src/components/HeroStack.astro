    <span class="stack-section__item" title="Claude">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.93 17.04l4.13-10.08h1.88l4.13 10.08h-1.92l-.92-2.36H9.78l-.93 2.36H6.93zm3.42-3.92h3.3l-1.65-4.24-1.65 4.24z"/>
      </svg>
      Claude
    </span>
  </div>
</section>

<style>
  .stack-section {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-inline: clamp(1rem, 2.5vw, 2rem);
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .stack-section__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .stack-section__label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-soft);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-right: 0.6rem;
  }

  .stack-section__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(245, 241, 234, 0.1);
    background: rgba(160, 195, 255, 0.05);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    transition:
      color var(--duration-hover) var(--ease-default),
      border-color var(--duration-hover) var(--ease-default),
      background-color var(--duration-hover) var(--ease-default);
  }
  .stack-section__item:hover {
    color: var(--accent-soft);
    border-color: rgba(94, 200, 255, 0.45);
    background: rgba(94, 200, 255, 0.09);
  }

  .stack-section__item svg {
    flex-shrink: 0;
    width: 18px !important;
    height: 18px !important;
  }
  .stack-section__item[title^="EVM"] svg {
    width: 15px !important;
    height: 18px !important;
  }

  /* Brand colors per tech */
  .stack-section__item[title="TypeScript"] svg { color: #3178c6; }
  .stack-section__item[title="Node.js"]    svg { color: #5fa04e; }
  .stack-section__item[title="Python"]     svg { color: #ffd43b; }
  .stack-section__item[title="React"]      svg { color: #61dafb; }
  .stack-section__item[title="Next.js"]    svg { color: #f5f1ea; }
  .stack-section__item[title="Svelte"]     svg { color: #ff3e00; }
  .stack-section__item[title="Rust"]       svg { color: #dea584; }
  .stack-section__item[title^="EVM"]       svg { color: #c4cbf5; }
  .stack-section__item[title="NEAR"]       svg { color: #f5f1ea; }
  .stack-section__item[title="SUI"]        svg { color: #4ca2ff; }
  .stack-section__item[title="Solana"]     svg { color: #14f195; }
  .stack-section__item[title="Cardano"]    svg { color: #5085ff; }
  .stack-section__item[title="GraphQL"]    svg { color: #e535ab; }
  .stack-section__item[title="Tailwind"]   svg { color: #38bdf8; }
  .stack-section__item[title="Claude"]     svg { color: #d97757; }
</style>
