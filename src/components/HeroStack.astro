        <circle cx="12" cy="17.6" r="1"/>
        <circle cx="7" cy="9.2" r="1"/>
        <circle cx="17" cy="9.2" r="1"/>
        <circle cx="7" cy="14.8" r="1"/>
        <circle cx="17" cy="14.8" r="1"/>
