---
interface Props {
  id?: string;
  class?: string;
  /** Tighter top/bottom padding. */
  tight?: boolean;
  /** Canonical top spacing for the first header block on internal pages. */
  pageHeader?: boolean;
}

const { id, class: className = "", tight = false, pageHeader = false } = Astro.props;
---

<section
  {id}
  class:list={[
    "section-y",
    tight && "section-y--tight",
    pageHeader && "section-y--page-header",
    className,
  ]}
>
  <div class="container-x">
    <slot />
  </div>
</section>

<style>
  .section-y--tight {
    padding-block: 3.5rem;
  }
  .section-y--page-header {
    padding-top: var(--section-y-mobile);
  }
  @media (min-width: 768px) {
    .section-y--tight {
      padding-block: 5rem;
    }
    .section-y--page-header {
      padding-top: var(--section-y-desktop);
    }
  }
</style>
