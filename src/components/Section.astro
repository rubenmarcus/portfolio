---
interface Props {
  id?: string;
  class?: string;
  /** Tighter top/bottom padding. */
  tight?: boolean;
}

const { id, class: className = "", tight = false } = Astro.props;
---

<section
  {id}
  class:list={[
    "section-y",
    tight && "section-y--tight",
    className,
  ]}
>
  <div class="container-x">
    <slot />
  </div>
</section>

<style>
  .section-y--tight {
    padding-block: 3rem;
  }
  @media (min-width: 768px) {
    .section-y--tight {
      padding-block: 4.5rem;
    }
  }
</style>
