---
import "../styles/globals.css"
import Analytics from "@vercel/analytics/astro"
import { site } from "../config/site"

interface Props {
  title?: string
  description?: string
}

const {
  title = site.seo.title,
  description = site.seo.description,
} = Astro.props

const sameAs = site.socials
  .filter((s) => !s.href.startsWith("mailto:"))
  .map((s) => s.href)
---

<!doctype html>
<html lang="en" class="bg-black">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.keywords} />
    <meta name="author" content={site.name} />
    <meta name="creator" content={site.name} />
    <meta name="robots" content="index, follow" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={site.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.tagline.en} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:image" content={site.seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.tagline.en} />
    <meta name="twitter:creator" content={site.seo.twitter} />
    <meta name="twitter:image" content={site.seo.ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@100..800&display=swap" rel="stylesheet" />

    <Analytics />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: site.name,
        url: site.url,
        alternateName: site.brand,
        jobTitle: site.roles.join(", "),
        description: site.tagline.en,
        email: site.email,
        sameAs,
        knowsAbout: site.seo.knowsAbout,
        worksFor: site.seo.worksFor,
      })}
    />
  </head>
  <body class="font-mono bg-black text-vesper-accent">
    <slot />
  </body>
</html>
