---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.svelte";
import Footer from "../components/Footer.svelte";
import AudioPlayer from "../components/AudioPlayer.svelte";
import AvailabilityMarquee from "../components/AvailabilityMarquee.svelte";
import SmoothScroll from "../components/SmoothScroll.svelte";
import ScrollFx from "../components/ScrollFx.svelte";
import IceFlowBg from "../components/IceFlowBg.svelte";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import FunnelAnalytics from "../components/FunnelAnalytics.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  /** og:type — "article" for blog posts, "website" everywhere else. */
  type?: "website" | "article";
  /** ISO dates for article:* meta tags (only emitted when type="article"). */
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  /** Canonical override — posts syndicated to dev.to/LinkedIn point there. */
  canonicalUrl?: string;
  /** Explicit locale pair for routes whose translated slugs differ. */
  alternatePaths?: { en: string; pt: string };
  /** Visible FAQ entries rendered by the page; used for matching FAQPage JSON-LD. */
  faq?: Array<{ question: string; answer: string }>;
}

const {
  title = "Ruben Marcus — AI Fullstack Engineer",
  description = "AI Fullstack Engineer building AI products, agent systems, AEO infrastructure, and high-performance web experiences. Based in Lisbon.",
  image = "/og/index.png",
  lang = "en",
  type = "website",
  publishedTime,
  modifiedTime,
  canonicalUrl,
  alternatePaths,
  faq = [],
} = Astro.props;

const canonicalURL = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;

// og:locale — only en_US / pt_BR exist on this site.
const ogLocale = lang.startsWith("pt") ? "pt_BR" : "en_US";
const ogLocaleAlternate = lang.startsWith("pt") ? "en_US" : "pt_BR";

const toIso = (d: Date | string) => (d instanceof Date ? d.toISOString() : d);

// hreflang pairs — /x ↔ /pt/x (home / ↔ /pt), x-default points at EN.
const pathname = Astro.url.pathname;
const isPt = pathname === "/pt" || pathname.startsWith("/pt/");
const pagePath = (value: string) => value === "/" || value.endsWith("/") ? value : `${value}/`;
const enPath = pagePath(alternatePaths?.en ?? (isPt ? pathname.replace(/^\/pt/, "") || "/" : pathname));
const ptPath = pagePath(alternatePaths?.pt ?? (isPt ? pathname : `/pt${pathname === "/" ? "" : pathname}`));

/* No custom view-transition animation: the cross-fade snapshots misbehave
   across browsers (stuck overlays, old page bleeding into the new one).
   ClientRouter still gives us instant swaps + persisted islands. */
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d10" />
    <meta name="author" content="Ruben Marcus" />
    <meta name="creator" content="Ruben Marcus" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="pt-br" href={new URL(ptPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Ruben Marcus — Blog" href="/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="Ruben Marcus — Blog (PT-BR)" href="/rss-pt.xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ruben Marcus" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {type === "article" && publishedTime && (
      <meta property="article:published_time" content={toIso(publishedTime)} />
    )}
    {type === "article" && modifiedTime && (
      <meta property="article:modified_time" content={toIso(modifiedTime)} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@rubenmarcus_dev" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <link rel="preload" href="/fonts/gabarito-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/uncut-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/uncut-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <ClientRouter />

    <Analytics />
    <SpeedInsights />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "https://rubenmarcus.dev/#organization",
            name: "Ruben Marcus",
            url: "https://rubenmarcus.dev/",
            logo: {
              "@type": "ImageObject",
              url: "https://rubenmarcus.dev/favicon.png",
            },
            founder: { "@id": "https://rubenmarcus.dev/#person" },
          },
          {
            "@type": "Person",
            "@id": "https://rubenmarcus.dev/#person",
            name: "Ruben Marcus",
            url: "https://rubenmarcus.dev/",
            jobTitle: "AI Fullstack Engineer",
            description: "AI Fullstack Engineer building AI products, agent systems, AEO infrastructure, and high-performance web experiences.",
            worksFor: { "@id": "https://rubenmarcus.dev/#organization" },
            sameAs: [
              "https://github.com/rubenmarcus",
              "https://x.com/rubenmarcus_dev",
              "https://linkedin.com/in/rubenmarcus",
              "https://www.npmjs.com/~rmarcus",
              "https://t.me/rubenmarcus",
            ],
            knowsAbout: [
              "AI Engineering",
              "Autonomous Agents",
              "Answer Engine Optimization",
              "Web3",
              "Blockchain",
              "Frontend Engineering",
              "TypeScript",
              "Astro",
              "Svelte",
              "Next.js",
            ],
          },
          {
            "@type": "WebSite",
            "@id": "https://rubenmarcus.dev/#website",
            url: "https://rubenmarcus.dev/",
            name: "Ruben Marcus",
            publisher: { "@id": "https://rubenmarcus.dev/#organization" },
            inLanguage: ["en", "pt-BR"],
          },
          {
            "@type": "WebPage",
            "@id": `${canonicalURL}#webpage`,
            url: canonicalURL,
            name: title,
            description,
            isPartOf: { "@id": "https://rubenmarcus.dev/#website" },
            about: { "@id": "https://rubenmarcus.dev/#person" },
            primaryImageOfPage: {
              "@type": "ImageObject",
              url: new URL(image, Astro.site).href,
            },
            inLanguage: lang,
          },
        ],
      })}
    />

    {faq.length > 0 && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: faq.map((item) => ({
            "@type": "Question",
            name: item.question,
            acceptedAnswer: { "@type": "Answer", text: item.answer },
          })),
        })}
      />
    )}

    <!-- Pages can inject extra head tags (e.g. BlogPosting JSON-LD). -->
    <slot name="head" />
  </head>
  <body>
    <SmoothScroll client:load transition:persist />
    <ScrollFx client:load />

    <!-- Site-wide Three.js ice-flow shader bg (FBM noise + glacial palette) —
         persisted across view transitions so the WebGL context survives. -->
    <IceFlowBg client:load transition:persist />

    <Header client:load currentPath={Astro.url.pathname} alternatePaths={alternatePaths} />

    <!-- Availability strip — site-wide, scrolling above all content,
         pinned to the very top edge over the header zone. -->
    <AvailabilityMarquee lang={lang} />

    <main>
      <slot />
    </main>

    <Footer client:visible lang={lang} />
    <FunnelAnalytics />

    <!-- Bottom audio deck — persisted across view transitions so the
         music keeps playing while navigating. -->
    <AudioPlayer client:load transition:persist />

    <script>
      const globalState = window as Window & { __portfolioWebMcp?: boolean };
      const modelContext = (document as any).modelContext ?? (navigator as any).modelContext;

      if (!globalState.__portfolioWebMcp && modelContext?.registerTool) {
        globalState.__portfolioWebMcp = true;
        const rpc = async (name: string) => {
          const response = await fetch("/api/mcp", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              jsonrpc: "2.0",
              id: crypto.randomUUID(),
              method: "tools/call",
              params: { name, arguments: {} },
            }),
          });
          if (!response.ok) throw new Error(`MCP request failed: ${response.status}`);
          return response.json();
        };

        modelContext.registerTool({
          name: "get_ruben_marcus_resume",
          description: "Return Ruben Marcus's public resume as structured JSON.",
          inputSchema: { type: "object", properties: {}, additionalProperties: false },
          annotations: { readOnlyHint: true },
          execute: async () => (await fetch("/api/resume.json")).json(),
        });
        modelContext.registerTool({
          name: "get_ruben_marcus_services",
          description: "List the AI engineering and product services offered by Ruben Marcus.",
          inputSchema: { type: "object", properties: {}, additionalProperties: false },
          annotations: { readOnlyHint: true },
          execute: async () => rpc("get_services"),
        });
        modelContext.registerTool({
          name: "check_ruben_marcus_availability",
          description: "Check Ruben Marcus's current public project availability.",
          inputSchema: { type: "object", properties: {}, additionalProperties: false },
          annotations: { readOnlyHint: true },
          execute: async () => rpc("check_availability"),
        });
      }
    </script>
  </body>
</html>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>
