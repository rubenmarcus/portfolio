---
import "../styles/global.css";
import Header from "../components/Header.svelte";
import Footer from "../components/Footer.svelte";
import SmoothScroll from "../components/SmoothScroll.svelte";
import CursorHalo from "../components/CursorHalo.svelte";
import ThreeBg from "../components/ThreeBg.svelte";
import QuantumLattice from "../components/QuantumLattice.svelte";
import Analytics from "@vercel/analytics/astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Three.js scene variant for this page's ambient background. */
  bgVariant?: "particles" | "lattice" | "rings";
}

const {
  title = "Ruben Marcus — AI Fullstack & Web3 Engineer",
  description = "Senior AI Fullstack Engineer building autonomous tooling, post-quantum infrastructure, and on-chain product surfaces at MultiVM Labs. Based in Lisbon.",
  image = "/thumbnail.png",
  bgVariant = "particles",
} = Astro.props;

// Route-aware: portfolio and AI pages add a Three.js statement piece on top
// of the global lattice. Everything else just gets the lattice.
const path = Astro.url.pathname;
let threeVariant: "particles" | "lattice" | "rings" | null = null;
if (path.startsWith("/portfolio")) threeVariant = "lattice";
else if (path.startsWith("/ai")) threeVariant = "rings";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0d10" />
    <meta name="author" content="Ruben Marcus" />
    <meta name="creator" content="Ruben Marcus" />
    <meta name="robots" content="index, follow" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ruben Marcus" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:creator" content="@rubenmarcus_dev" />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300..700&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <Analytics />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Ruben Marcus",
        url: "https://rubenmarcus.dev",
        jobTitle: "AI Fullstack & Web3 Engineer",
        description,
        sameAs: [
          "https://github.com/rubenmarcus",
          "https://x.com/rubenmarcus_dev",
          "https://linkedin.com/in/rubenmarcus",
          "https://dev.to/rubenmarcus",
          "https://t.me/rubenmarcus",
        ],
        knowsAbout: [
          "AI Engineering",
          "Autonomous Agents",
          "Post-Quantum Cryptography",
          "Web3",
          "Blockchain",
          "Frontend Engineering",
          "TypeScript",
          "Astro",
          "Svelte",
          "Next.js",
        ],
        worksFor: [
          { "@type": "Organization", name: "MultiVM Labs", url: "https://multivmlabs.com" },
        ],
      })}
    />
  </head>
  <body>
    <SmoothScroll client:load />

    <!-- Site-wide ambient lattice — Canvas 2D, ice-blue tuned -->
    <div class="lattice-wrap" aria-hidden="true">
      <QuantumLattice client:load />
    </div>

    <!-- Optional Three.js statement piece for /portfolio and /ai -->
    {threeVariant && (
      <div class="three-bg-wrap" aria-hidden="true">
        <ThreeBg client:load variant={threeVariant} count={200} />
      </div>
    )}

    <CursorHalo client:load />
    <Header client:load currentPath={Astro.url.pathname} />

    <main>
      <slot />
    </main>

    <Footer />

    <!-- Scramble-on-hover for [data-scramble] targets, plus auto-tagging of
         .link-inline and .nav-link anchors so titles + links shimmer on hover. -->
    <script>
      import { mountScrambleGlobals, bindScramble } from "../lib/motion/scramble";

      function tagAndMount() {
        // Auto-mount everything explicitly marked [data-scramble]
        mountScrambleGlobals();
        // Also auto-tag and bind common interactive text targets
        const auto = document.querySelectorAll<HTMLElement>(
          ".link-inline, .nav-link, .work-title, .article-title, .proj-title, .tool__name, .ai-card__name, .support-card__name, .timeline-role, .filter__label",
        );
        auto.forEach((el) => {
          if (el.dataset.scrambleBound === "true") return;
          el.dataset.scrambleBound = "true";
          bindScramble(el, { tick: 24, speed: 0.7 });
        });
      }

      tagAndMount();
      // Re-mount after view-transition or async hydration adds new elements
      document.addEventListener("astro:page-load", tagAndMount);
    </script>

    <style>
      .lattice-wrap {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.55;
        /* Center mask — keep content area readable */
        mask-image: radial-gradient(ellipse at center, transparent 12%, #000 55%);
        -webkit-mask-image: radial-gradient(ellipse at center, transparent 12%, #000 55%);
      }
      .three-bg-wrap {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        opacity: 0.5;
        mask-image: radial-gradient(ellipse at center, transparent 16%, #000 60%);
        -webkit-mask-image: radial-gradient(ellipse at center, transparent 16%, #000 60%);
      }
    </style>
  </body>
</html>
