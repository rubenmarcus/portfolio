# Resend — https://resend.com/api-keys (server only)
RESEND_API_KEY=re_xxxxxxxx

# Cloudflare Turnstile — https://dash.cloudflare.com/ (recommended in production)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis — https://console.upstash.com/ (optional; enables /api/contact rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub — server only; powers the marquee stats (/api/github-stats)
# Fine-grained: all repositories, Contents + Metadata (read). Classic: scope "repo".
# Must belong to the same user as site.githubUser (jseramn). Create at:
# https://github.com/settings/tokens?type=beta  or  https://github.com/settings/tokens
GITHUB_TOKEN=
