# Optional — the site builds and runs fine without any of these.

# Blog view counter (public/anon keys, client-side only).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Only used by the asset-generation scripts in scripts/ (covers, OG images,
# logos, portraits). Never shipped to the client.
OPENROUTER_API_KEY=

# Optional second destination for contact leads. Configure a private webhook
# (CRM, automation, database function, etc.) so lead delivery does not depend
# on the email relay alone. These values are server-side only.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_TOKEN=
